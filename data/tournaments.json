    "rules": [
      {
        "id": "dm-rule-1",
        "title": "Christian Fellowship & Fair Play",
        "category": "Code of Conduct",
        "content": "All matches begin with a joint team prayer in the center circle. Mutual respect, exemplary sportsmanship, and polite language towards opponents and referees are mandatory at all times."
      },
      {
        "id": "dm-rule-2",
        "title": "Parishioner Eligibility & Verification",
        "category": "Rosters",
        "content": "All players must be registered parish members of Divine Mercy Church residing within their respective ward boundaries. Squad lists (14 players maximum) must be certified by the parish priest."
      },
      {
        "id": "dm-rule-3",
        "title": "Group Stage Qualification & Tie-Breakers",
        "category": "Tournament Format",
        "content": "Teams play a round-robin within their group. Win = 3 points, Draw = 1 point, Loss = 0 points. Top 2 teams from Group A and Group B advance to the Semi-Finals. Tie-breakers: 1) Head-to-Head result, 2) Goal Difference, 3) Higher Goals Scored."
      },
      {
        "id": "dm-rule-4",
        "title": "Playoff Semi-Finals & Final Structure",
        "category": "Knockout Rules",
        "content": "Semi-Final 1: Winner Group A vs Runner-up Group B. Semi-Final 2: Winner Group B vs Runner-up Group A. If tied at full time, direct penalty shootout (5 kicks each) decides the advancing team."
      }
    ],
